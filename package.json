{
  "name": "prediction-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Bloomberg-style terminal for Kalshi, Polymarket and Polymarket US prediction markets, twelve reference-data publishers (FRED, BLS, Federal Reserve, ECB, OECD, IMF, EIA, CFTC, Congress.gov, SEC EDGAR, data.gov, Polygon.io), and the Billboard charts.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test --import tsx \"test/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "lightweight-charts": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
