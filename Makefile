# Prediction Terminal — build and development tasks.
#
# The terminal is two programs: a Rust API server (`server/`) and a SvelteKit
# client (`client/`). In development they run side by side and Vite proxies
# `/api` to the server. In production the server binary serves the built client
# itself, so a deployment is one process and one port.

CLIENT      := client
CLIENT_DIR  ?= $(CURDIR)/client/build
GEN_DIR     := client/src/lib/api/gen
NPM         := npm --prefix $(CLIENT)

# The single-file snapshot build. See the `snapshot` target.
SNAPSHOT_BASE ?= http://127.0.0.1:8787
SNAPSHOT_FILE ?= $(CLIENT)/snapshot.json
SNAPSHOT_OUT  ?= dist/prediction-terminal.html

.DEFAULT_GOAL := help
.PHONY: help dev dev-server dev-client build build-client build-server \
        gen-types gen-drift check check-rust check-client fmt lint test \
        test-rust test-client start clean install \
        snapshot record-snapshot build-snapshot

help: ## List the available targets.
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) \
	  | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

install: ## Install client dependencies.
	$(NPM) install

dev: ## Run the API server and the client dev server together.
	@echo "API  → http://127.0.0.1:8787"
	@echo "APP  → http://127.0.0.1:5173"
	@trap 'kill 0' EXIT INT TERM; \
	cargo run -p terminal-server & \
	$(NPM) run dev & \
	wait

dev-server: ## Run only the API server (port 8787).
	cargo run -p terminal-server

dev-client: ## Run only the client dev server (port 5173, proxies /api).
	$(NPM) run dev

gen-types: ## Regenerate the TypeScript wire types from the Rust structs.
	@rm -rf $(GEN_DIR)
	cargo test -p terminal-core --lib export_bindings
	@printf '// Generated by `make gen-types`. Do not edit.\n' > $(GEN_DIR)/index.ts
	@for f in $(GEN_DIR)/*.ts; do \
	  name=$$(basename $$f .ts); \
	  [ "$$name" = "index" ] || printf 'export type { %s } from "./%s";\n' "$$name" "$$name" >> $(GEN_DIR)/index.ts; \
	done
	@echo "wrote $$(ls $(GEN_DIR)/*.ts | wc -l) declarations"

gen-drift: gen-types ## Fail if the committed types differ from the Rust structs.
	@git diff --exit-code $(GEN_DIR) \
	  || { echo "error: generated types are stale — commit the regenerated files"; exit 1; }

fmt: ## Format the Rust sources.
	cargo fmt --all

lint: ## Lint everything.
	cargo fmt --all --check
	cargo clippy --workspace --all-targets -- -D warnings
	$(NPM) run lint

test-rust: ## Run the Rust test suite.
	cargo test --workspace

test-client: ## Run the client test suite.
	$(NPM) run test

test: test-rust test-client ## Run every test.

check-rust: ## Format check, lint and test the Rust side.
	cargo fmt --all --check
	cargo clippy --workspace --all-targets -- -D warnings
	cargo test --workspace

check-client: ## Type-check, lint, test and build the client.
	$(NPM) run check
	$(NPM) run test
	$(NPM) run build

check: check-rust gen-drift check-client ## The full gate. What CI runs.

build-client: ## Build the client into client/build.
	$(NPM) run build

build-server: ## Build the release server binary.
	cargo build --release -p terminal-server

build: build-client build-server ## Build both halves for production.

# --------------------------------------------------------------- snapshot --
#
# One HTML file of the whole terminal, with a recorded API session frozen into
# it. For a host that will not run a process — an object store, a static site,
# a link sent to someone who should not have to install a Rust toolchain to
# look at it. The prices in it are as old as the recording; nothing in it is
# live, and the header says SNAPSHOT rather than LIVE for that reason.

record-snapshot: ## Record an API session. Needs a server on :8787 and Playwright.
	node tools/record-snapshot.mjs --base $(SNAPSHOT_BASE) --out $(SNAPSHOT_FILE)

build-snapshot: ## Bundle the client flat for a snapshot build.
	$(NPM) run build:snapshot

snapshot: build-snapshot ## Pack the terminal into one self-contained HTML file.
	node tools/pack-single-file.mjs \
	  --build $(CLIENT)/snapshot-build \
	  --snapshot $(SNAPSHOT_FILE) \
	  --out $(SNAPSHOT_OUT)

start: ## Serve the built client and the API from one process.
	CLIENT_DIR=$(CLIENT_DIR) ./target/release/terminal-server

clean: ## Remove build output.
	cargo clean
	rm -rf $(CLIENT)/build $(CLIENT)/.svelte-kit $(CLIENT)/snapshot-build dist
