# All optional — the terminal runs with none of these set.

# API server bind. HOST=0.0.0.0 to expose it beyond localhost.
PORT=8787
HOST=127.0.0.1

# Max API calls per client IP per minute.
RATE_LIMIT=600

# FRED data is scraped from fred.stlouisfed.org by default. That host resets
# connections from datacentre and cloud IPs, so a hosted deployment often
# cannot scrape it at all. Setting a key (free, from
# https://fred.stlouisfed.org/docs/api/api_key.html) adds a fallback to the
# official API, which does answer from those networks. The scrape is always
# tried first.
# FRED_API_KEY=

# The news wire (`NEWS`) reads Alpaca's news API, which is the one feed here
# that needs a credential — no unauthenticated equity news feed exists that is
# both licensed and stable enough to parse. Keys are free from alpaca.markets;
# a paper-trading account issues a pair, and this server only ever sends them to
# data.alpaca.markets to read news. Every other command works without them.
# Alpaca's own SDK names (APCA_API_KEY_ID / APCA_API_SECRET_KEY) are read too.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# Upstream overrides. Mainly for testing against a fixture server.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# FRED_WEB_BASE=https://fred.stlouisfed.org
# FRED_API_BASE=https://api.stlouisfed.org/fred
# ALPACA_DATA_BASE=https://data.alpaca.markets/v1beta1

# Polymarket International splits its public API across three hosts: the
# catalogue, the CLOB (books and price history) and the print tape.
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com
# POLYMARKET_DATA_BASE=https://data-api.polymarket.com

# Polymarket US serves catalogue, book and BBO from a public gateway. Its price
# history and trade tape live on api.polymarket.us behind an API key, which this
# terminal deliberately does not hold — GP and TAS on a pmus: market say so.
# POLYMARKET_US_API_BASE=https://gateway.polymarket.us

# Gemini serves its prediction-market catalogue from the web host and its book,
# tape and candles from the same api.gemini.com the crypto exchange uses.
# GEMINI_CATALOGUE_BASE=https://www.gemini.com
# GEMINI_API_BASE=https://api.gemini.com

# predict.fun documents a REST API at api.predict.fun that requires an account
# key on every path, including its own "get the message to sign" step. Its web
# app does not use it: the public data is on a GraphQL host that needs no
# credential, and that is what this terminal reads. Send no Origin header or
# exactly https://predict.fun — the host answers any other with a 403.
# PREDICTFUN_GRAPHQL_URL=https://graphql.predict.fun/graphql

# ForecastEx serves an undocumented JSON API from its own site, and publishes
# its end-of-session archives — the print tape and the daily bars — as CSV in a
# public S3 bucket. Both are read; neither needs a credential.
# FORECASTEX_API_BASE=https://forecastex.com
# FORECASTEX_ARCHIVE_BASE=https://forecastex-public-data.s3.amazonaws.com
