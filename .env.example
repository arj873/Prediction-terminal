# All optional — the terminal runs with none of these set.

# API server bind. HOST=0.0.0.0 to expose it beyond localhost.
PORT=8787
HOST=127.0.0.1

# Max API calls per client IP per minute.
RATE_LIMIT=600

# FRED data is scraped from fred.stlouisfed.org by default. That host resets
# connections from datacentre and cloud IPs, so a hosted deployment often
# cannot scrape it at all. Setting a key (free, from
# https://fred.stlouisfed.org/docs/api/api_key.html) adds a fallback to the
# official API, which does answer from those networks. The scrape is always
# tried first.
# FRED_API_KEY=

# Upstream overrides. Mainly for testing against a fixture server.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# FRED_WEB_BASE=https://fred.stlouisfed.org
# FRED_API_BASE=https://api.stlouisfed.org/fred

# Polymarket International splits its public API across three hosts: the
# catalogue, the CLOB (books and price history) and the print tape.
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com
# POLYMARKET_DATA_BASE=https://data-api.polymarket.com

# Polymarket US serves catalogue, book and BBO from a public gateway. Its price
# history and trade tape live on api.polymarket.us behind an API key, which this
# terminal deliberately does not hold — GP and TAS on a pmus: market say so.
# POLYMARKET_US_API_BASE=https://gateway.polymarket.us
